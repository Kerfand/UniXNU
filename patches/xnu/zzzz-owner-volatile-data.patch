+// Mount the RAM-backed Data volume at /private/var. launchd needs a writable /private/var
+// before it can finish its libxpc bootstrap; without one it exits and the kernel panics
+// with "initproc exited". Everything here mirrors native_owner_cache_prepare(): the same
+// struct mount_args, the same APFS mount payload layout, and mount() through the kernel
+// entry point. Failing is not fatal, so the boot still produces a log.
+extern int native_volatile_data_device(dev_t *, char *, size_t);
+
+static int
+native_owner_volatile_mount(proc_t p, user_addr_t scratch)
+{
+	const char *mountpoint = "/private/var";
+	dev_t device = NODEV;
+	char device_path[64] = {0};
+	uint8_t mount_data[0x150] = {0};
+	uint64_t mount_flags = 0;
+	uint16_t mount_mode = 1;
+	uint32_t anonymous_owner = 99;
+	user64_addr_t spec = scratch + 0x160;
+	vnode_t mount_vnode = NULLVP;
+	int32_t result = 0;
+	int error;
+
+	if (!native_volatile_data_device(&device, device_path, sizeof(device_path))) {
+		kprintf("NATIVE_OWNER data: no volatile Data volume in this payload\n");
+		return ENOENT;
+	}
+	kprintf("NATIVE_OWNER data: device_path=%s\n", device_path);
+	error = vnode_lookup(mountpoint, 0, &mount_vnode, vfs_context_current());
+	if (mount_vnode) vnode_put(mount_vnode);
+	if (error) {
+		kprintf("NATIVE_OWNER data: %s lookup error=%d\n", mountpoint, error);
+		return error;
+	}
+	memcpy(mount_data, &spec, sizeof(spec));
+	memcpy(mount_data + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(mount_data + 16, &mount_mode, sizeof(mount_mode));
+	memcpy(mount_data + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(mount_data + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = (int)mount_flags, .data = scratch + 0x200};
+	if ((error = copyout("apfs", request.type, 5)) != 0 ||
+	    (error = copyout(mountpoint, request.path, strlen(mountpoint) + 1)) != 0 ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
+	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) {
+		kprintf("NATIVE_OWNER data: copyout error=%d\n", error);
+		return error;
+	}
+	error = mount(p, &request, &result);
+	kprintf("NATIVE_OWNER data: mount %s error=%d result=%d\n", mountpoint, error, (int)result);
+	return error;
+}
+
