--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8046,6 +8046,66 @@
 }
 #endif
 
+#ifndef NATIVE_OWNER_DATA_SEED_UUID
+#define NATIVE_OWNER_DATA_SEED_UUID "3E70F8EF-2DA7-402B-ADF8-BC4D10541070"
+#endif
+// Mount the writable Data volume at /private/var. launchd needs a writable /private/var before it
+// can finish its libxpc bootstrap; without one it exits and the kernel panics with "initproc
+// exited". The media comes from the payload's Data seed through the ram block driver, which owns
+// the region and exports the seed identity; this only performs the APFS mount, with the same
+// struct mount_args and payload layout native_owner_data_prepare uses. Failing is not fatal.
+extern int native_ram_block_volume_seed(const char *, dev_t *, char *, size_t, uint64_t *,
+    uint64_t *, uint8_t *);
+
+static int
+native_owner_volatile_mount(proc_t p, user_addr_t scratch)
+{
+	const char *mountpoint = "/private/var";
+	dev_t device = NODEV;
+	char device_path[64] = {0};
+	uint64_t seed_base = 0, seed_size = 0;
+	uint8_t seed_sha256[32] = {0};
+	uint8_t mount_data[0x150] = {0};
+	uint64_t mount_flags = 0;
+	uint16_t mount_mode = 1;
+	uint32_t anonymous_owner = 99;
+	user64_addr_t spec = scratch + 0x160;
+	vnode_t mount_vnode = NULLVP;
+	int32_t result = 0;
+	int error;
+
+	if (!native_ram_block_volume_seed(NATIVE_OWNER_DATA_SEED_UUID, &device, device_path,
+	    sizeof(device_path), &seed_base, &seed_size, seed_sha256)) {
+		kprintf("NATIVE_OWNER data: the ram block driver published no Data seed\n");
+		return ENOENT;
+	}
+	kprintf("NATIVE_OWNER data: device_path=%s base=0x%llx bytes=%llu\n", device_path,
+	    (unsigned long long)seed_base, (unsigned long long)seed_size);
+	error = vnode_lookup(mountpoint, 0, &mount_vnode, vfs_context_current());
+	if (mount_vnode) vnode_put(mount_vnode);
+	if (error) {
+		kprintf("NATIVE_OWNER data: %s lookup error=%d\n", mountpoint, error);
+		return error;
+	}
+	memcpy(mount_data, &spec, sizeof(spec));
+	memcpy(mount_data + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(mount_data + 16, &mount_mode, sizeof(mount_mode));
+	memcpy(mount_data + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(mount_data + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = (int)mount_flags, .data = scratch + 0x200};
+	if ((error = copyout("apfs", request.type, 5)) != 0 ||
+	    (error = copyout(mountpoint, request.path, strlen(mountpoint) + 1)) != 0 ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
+	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) {
+		kprintf("NATIVE_OWNER data: copyout error=%d\n", error);
+		return error;
+	}
+	error = mount(p, &request, &result);
+	kprintf("NATIVE_OWNER data: mount %s error=%d result=%d\n", mountpoint, error, (int)result);
+	return error;
+}
+
 static int
 load_init_program_at_path(proc_t p, user_addr_t scratch_addr, const char* path, user_addr_t envp)
 {
@@ -8188,6 +8248,9 @@
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
 	boot_progress_stage("SystemOS mount returned");
 	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	int volatile_error = native_owner_volatile_mount(p, (user_addr_t)scratch_addr);
+	if (volatile_error) kprintf("NATIVE_OWNER data: /private/var unavailable (%d); continuing\n",
+	    volatile_error);
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
 	boot_progress_stage("Data mount enter");
